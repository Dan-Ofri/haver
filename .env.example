# Copy this file to .env and fill in your own keys. .env is git-ignored and never committed.

# Which model answers: "offline" (no key needed, a fixed stand-in) or "gemini".
LLM_PROVIDER=offline
GEMINI_MODEL=gemini-3.8-flash

# Free key from Google AI Studio. Free-tier content may be used by Google: demo data only.
GEMINI_API_KEY=

# Optional. Free key from the Groq console, for personal data (no training on API data).
GROQ_API_KEY=

# Only needed when running the backend outside Docker.
DATABASE_URL=postgresql://haver:haver@localhost:5432/haver
